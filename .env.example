# ---------- Supabase (จำเป็น) ----------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด คีย์นี้ข้าม RLS ได้ทั้งหมด
# ใช้เฉพาะงานเบื้องหลัง เช่น worker สร้าง embedding
SUPABASE_SERVICE_ROLE_KEY=

# ---------- ชั้นที่ 3 ของระบบแนะนำ (ไม่ใส่ก็ใช้งานได้) ----------
# ใส่อันใดอันหนึ่งพอ ไม่ใส่เลยระบบจะใช้ข้อความสำเร็จรูปแทน
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
TYPHOON_API_KEY=
# TYPHOON_MODEL=typhoon-v2.1-12b-instruct
